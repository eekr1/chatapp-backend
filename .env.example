# Core runtime
NODE_ENV=development
APP_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talkx
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

# Admin panel
ADMIN_PANEL_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_AUTH_RATE_WINDOW_MS=600000
ADMIN_AUTH_RATE_MAX=10

# Firebase push: configure exactly one credential source.
# Never commit a real service-account value or file.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_EXPECTED_PROJECT_ID=your-project-id
PUSH_DM_DEBOUNCE_MS=15000
PUSH_DM_DEBOUNCE_MAX_KEYS=50000

# Support email (Brevo)
BREVO_API_KEY=
SUPPORT_FROM_EMAIL=support@example.com
SUPPORT_FROM_NAME=TalkX Support
SUPPORT_TO_EMAILS=owner@example.com
SUPPORT_SUBJECT_PREFIX=[TalkX Support]
SUPPORT_RATE_LIMIT_MAX=10
SUPPORT_RATE_LIMIT_WINDOW_MS=900000

# Privacy, retention and scheduled notifications
ERASURE_HMAC_KEY=replace-with-a-random-secret
ERASURE_HMAC_KEY_VERSION=v1
LOG_PSEUDONYM_SALT=replace-with-a-random-secret
BEHAVIOR_EVENTS_RETENTION_DAYS=90
NOTIFICATION_SCHEDULER_INTERVAL_MS=30000
NOTIFICATION_DEFAULT_TIMEZONE=Europe/Istanbul
MEDIA_CLEANUP_EXECUTE=false

# Database pool and readiness
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
DB_READINESS_TIMEOUT_MS=4000

# Realtime topology and recovery
REALTIME_TOPOLOGY=single
REALTIME_RECOVERY_ENABLED=false
RECOVERY_GRACE_MS=15000
PRESENCE_HEARTBEAT_MS=30000
PRESENCE_LEASE_MS=90000
PRESENCE_STALE_MS=120000
INSTANCE_ID=local-single
APP_RELEASE=local
# Hosted providers may populate these automatically.
COMMIT_SHA=
GIT_COMMIT=
RENDER_GIT_COMMIT=
RENDER_INSTANCE_ID=
MATCH_CONFIRM_TIMEOUT_MS=15000
MATCH_REMATCH_COOLDOWN_MS=3000

# Country matching
MATCH_COUNTRY_FALLBACK_MS=30000
MATCH_COUNTRY_REFRESH_MS=604800000
MATCH_COUNTRY_RETRY_MS=21600000
MATCH_COUNTRY_BACKFILL_BATCH_SIZE=100
MATCH_COUNTRY_BACKFILL_BATCH_DELAY_MS=5000
MATCH_COUNTRY_BACKFILL_IDLE_MS=21600000

# Admin geo lookup
ADMIN_GEO_LOOKUP_TIMEOUT_MS=3500
ADMIN_GEO_CACHE_TTL_MS=86400000
ADMIN_GEO_DB_REFRESH_MS=604800000
ADMIN_GEO_PROFILE_LIST_CONCURRENCY=2
ADMIN_GEO_PROFILE_LIST_LOOKUP_LIMIT=8

# Performance thresholds
PERF_MIN_PERCENTILE_SAMPLES=20
PERF_P95_WARNING_MS=800
PERF_P95_CRITICAL_MS=1500
PERF_ERROR_WARNING_PERCENT=2
PERF_ERROR_CRITICAL_PERCENT=5
PERF_STALE_AFTER_MINUTES=15

# Optional backup verification binary override
PG_RESTORE_BIN=pg_restore
