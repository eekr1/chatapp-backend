{
  "name": "anon-chat-backend",
  "version": "1.0.0",
  "description": "Anonymous 1-on-1 Chat Backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "quality:policy": "node scripts/quality-gate.mjs self-test",
    "quality:syntax": "node scripts/quality-gate.mjs syntax",
    "quality:core": "node scripts/quality-gate.mjs core",
    "quality:critical": "node scripts/quality-gate.mjs critical",
    "quality:audit": "npm audit --omit=dev --audit-level=high",
    "quality:all": "npm run quality:policy && npm run quality:syntax && npm run quality:core && npm run quality:critical && npm run quality:audit",
    "migration:run": "node scripts/migrate.js",
    "migration:status": "node scripts/migration-status.js",
    "backup:verify": "node scripts/verify-backup.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.1",
    "multer": "^2.1.0",
    "pg": "^8.17.2",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  }
}
